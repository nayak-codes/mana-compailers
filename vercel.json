{
  "cleanUrls": true,
  "functions": {
    "api/run.js": {
      "maxDuration": 60
    },
    "api/clipboard.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ourcompiler.vercel.app"
        }
      ],
      "destination": "https://www.ourcompiler.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog-java/01-java-java-:slug*",
      "destination": "/blog-java/01-java-introduction-features-and-jvm-architecture.html",
      "permanent": true
    },
    {
      "source": "/blog-java/02-java-java-:slug*",
      "destination": "/blog-java/02-java-installation-ide-and-first-program.html",
      "permanent": true
    },
    {
      "source": "/blog-java/03-java-how-:slug*",
      "destination": "/blog-java/03-java-syntax-class-structure-and-main-method.html",
      "permanent": true
    },
    {
      "source": "/blog-java/04-java-java-:slug*",
      "destination": "/blog-java/04-java-variables-primitive-data-types-and-memory.html",
      "permanent": true
    },
    {
      "source": "/blog-java/05-java-java-:slug*",
      "destination": "/blog-java/05-java-operators-expressions-and-type-casting.html",
      "permanent": true
    },
    {
      "source": "/blog-java/:prefix(\\d{2})-java-java-:slug*",
      "destination": "/blog-java.html",
      "permanent": true
    },
    {
      "source": "/(blog-angular|blog-css|blog-django|blog-express|blog-flask|blog-git|blog-go|blog-graphql|blog-mongodb|blog-mysql|blog-nextjs|blog-nodejs|blog-php|blog-postgresql|blog-react|blog-rest-api|blog-ruby|blog-rust|blog-springboot|blog-testing|blog-vue|portfolio)(.*)",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/(java|python)",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/(java|python)/:path*",
      "destination": "/blog",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(blog-angular|blog-css|blog-django|blog-express|blog-flask|blog-git|blog-go|blog-graphql|blog-mongodb|blog-mysql|blog-nextjs|blog-nodejs|blog-php|blog-postgresql|blog-react|blog-rest-api|blog-ruby|blog-rust|blog-springboot|blog-testing|blog-vue|portfolio)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(java|python)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}