{
  "cleanUrls": true,
  "functions": {
    "api/run.js": {
      "maxDuration": 60
    },
    "api/clipboard.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ourcompiler.vercel.app"
        }
      ],
      "destination": "https://www.ourcompiler.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
